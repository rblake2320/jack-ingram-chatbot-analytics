# Copy to .env (git-ignored) and fill in. Never commit real values.
# PowerShell:  Copy-Item .env.example .env
# Generate secrets with:  python -m chatbot.cli gen-secret

# --- runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_DIR=./var

# --- required in production (>= 32 chars each) ---
SESSION_SECRET=
LEDGER_HMAC_KEY=
ADMIN_TOKEN=

# --- Claude (optional: without it the deterministic fallback responder answers) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_REFUSAL_FALLBACKS=true

# --- optional live-data integrations ---
NHTSA_ENABLED=true
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
FIRECRAWL_API_KEY=
# Comma-separated https URLs of the dealership's own specials pages (only these are ever scraped)
SPECIALS_URLS=

# --- CRM delivery (transactional outbox; https required in production) ---
CRM_WEBHOOK_URL=
# json | adf  (ADF 1.0 XML for VinSolutions / DealerSocket / Elead style lead intake)
CRM_WEBHOOK_FORMAT=json
WEBHOOK_SIGNING_SECRET=

# --- web / embedding ---
# Comma-separated origins allowed to call the API cross-origin (e.g. the dealership site)
CORS_ORIGINS=
# Comma-separated origins allowed to iframe the chat (CSP frame-ancestors)
FRAME_ANCESTORS=
# Set to do-connecting-ip on DigitalOcean App Platform so rate limits see the real client IP
CLIENT_IP_HEADER=

# --- scheduling ---
TIMEZONE=America/Chicago
APPOINTMENT_HORIZON_DAYS=30
APPOINTMENT_MIN_LEAD_MINUTES=120
# Comma-separated YYYY-MM-DD dates the stores are closed (in addition to the built-in holidays)
CLOSED_DATES=

# --- data feeds (default: bundled SAMPLE data) ---
DEALERSHIP_FILE=
INVENTORY_FEED_PATH=
