{
  "spec": {
    "name": "jack-ingram-chatbot",
    "region": "nyc",
    "services": [
      {
        "name": "web",
        "github": {
          "repo": "rblake2320/jack-ingram-chatbot-analytics",
          "branch": "main",
          "deploy_on_push": true
        },
        "source_dir": "src/demo",
        "dockerfile_path": "src/demo/Dockerfile",
        "http_port": 8080,
        "instance_size_slug": "basic-xxs",
        "instance_count": 1,
        "health_check": {"http_path": "/health"},
        "envs": [
          {"key": "ENVIRONMENT", "value": "production", "scope": "RUN_TIME"},
          {"key": "CLIENT_IP_HEADER", "value": "do-connecting-ip", "scope": "RUN_TIME"},
          {"key": "WEB_CONCURRENCY", "value": "2", "scope": "RUN_TIME"},
          {"key": "ANTHROPIC_MODEL", "value": "claude-opus-5-5", "scope": "RUN_TIME"}
        ],
        "routes": [{"path": "/"}]
      }
    ]
  }
}
